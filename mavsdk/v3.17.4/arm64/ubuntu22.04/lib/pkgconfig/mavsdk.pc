prefix=/home/firefly/practise/MAVSDK/install
exec_prefix=/home/firefly/practise/MAVSDK/install/bin
libdir=/home/firefly/practise/MAVSDK/install/lib
includedir=/home/firefly/practise/MAVSDK/install/include

Name: MAVSDK
Description: API and library for MAVLink compatible systems written in C++17
Version: 3.17.4
Requires.private: libcurl jsoncpp tinyxml2
Libs: -L"${libdir}" -lmavsdk
Cflags: -I"${includedir}" -I"${includedir}/mavsdk"
